<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WiseCardOcrTest" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#F8FAFC</item>
        <item name="android:colorAccent">#4F46E5</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:backgroundTint">#4F46E5</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">#0F172A</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ResultText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">#FFFFFF</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">#334155</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
